    <!-- Proctoring & Timer Scripts -->

    <script>

        const durationMinutes = {{ $test->duration_minutes }};

        let remainingTimeSeconds = {{ $remainingSeconds }};

        let timerInterval = null;

        let isExamStarted = false;

        let isSubmitting = false;

        let isCurrentlyFullscreen = false;

        let isCurrentlyVisible = true;

        let lastFullscreenExitTime = 0;

        let lastTabSwitchTime = 0;

        const saveAnswerUrl = "{{ route('student.classrooms.tests.save-answer', [$classroom, $test]) }}";

        const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');

        const webcam = document.getElementById('webcamPreview');

        const startOverlay = document.getElementById('startOverlay');

        const btnBeginExam = document.getElementById('btnBeginExam');

        const fullscreenWarningOverlay = document.getElementById('fullscreenWarningOverlay');

        const btnReturnFullscreen = document.getElementById('btnReturnFullscreen');

        const fsCountdown = document.getElementById('fsCountdown');

        const timerDisplay = document.getElementById('examTimerDisplay');

        const examForm = document.getElementById('examForm');

        let fsWarningTimer = null;

        let fsWarningSeconds = 15;

        // =========================================

        // CLIPBOARD BLOCKING (COPY / CUT / PASTE)

        // =========================================

        document.addEventListener('copy', function (event) {

            event.preventDefault();

            console.log('Copy blocked in SecureTest.');

        });

        document.addEventListener('cut', function (event) {

            event.preventDefault();

            console.log('Cut blocked in SecureTest.');

        });

        document.addEventListener('paste', function (event) {

            event.preventDefault();

            console.log('Paste blocked in SecureTest.');

        });

        // Check if webcam video stream track is live and enabled

        function isCameraStreamLive() {

            if (!webcam || !webcam.srcObject) return false;

            const stream = webcam.srcObject;

            const tracks = stream.getVideoTracks();

            if (!tracks || tracks.length === 0) return false;

            return tracks[0].readyState === 'live' && tracks[0].enabled;

        }

        // Initialize Camera

        async function initCamera() {

            try {

                const stream = await navigator.mediaDevices.getUserMedia({

                    video: true,

                    audio: false

                });

                webcam.srcObject = stream;

                try {

                    await webcam.play();

                } catch (playErr) {

                    console.warn('Webcam playback error:', playErr);

                }

                const cameraStatusText = document.getElementById('cameraStatusText');

                if (cameraStatusText) {

                    cameraStatusText.textContent = 'Active';

                    cameraStatusText.className = 'font-semibold text-emerald-600';

                }

                // Handle camera stream termination (unplugged, disabled, or revoked)

                const videoTrack = stream.getVideoTracks()[0];

                if (videoTrack) {

                    videoTrack.onended = function () {

                        console.warn('Camera stopped or disconnected.');

                        if (cameraStatusText) {

                            cameraStatusText.textContent = 'Disconnected';

                            cameraStatusText.className = 'font-semibold text-rose-600';

                        }

                        const camOverlayStatus = document.getElementById('camOverlayStatus');

                        if (camOverlayStatus) {

                            camOverlayStatus.textContent = '⚠️ Camera Disconnected';

                        }

                        reportCheatingEvent('camera_disconnected', 'Webcam stream disconnected or access revoked.');

                        const fullscreenWarningOverlay = document.getElementById('fullscreenWarningOverlay');

                        const fullscreenWarningText = document.getElementById('fullscreenWarningText');

                        if (fullscreenWarningOverlay && fullscreenWarningText) {

                            fullscreenWarningText.textContent = 'Camera stream was stopped or disconnected. Live webcam access is required to continue the examination.';

                            fullscreenWarningOverlay.style.display = 'flex';

                        }

                    };

                }

                return true;

            } catch (err) {

                console.error('Camera access error:', err);

                const cameraStatusText = document.getElementById('cameraStatusText');

                if (cameraStatusText) {

                    cameraStatusText.textContent = 'Permission Denied';

                    cameraStatusText.className = 'font-semibold text-rose-600';

                }

                alert('Camera access is strictly required to undertake this examination. Please allow camera permissions.');

                return false;

            }

        }

        const attemptId = {{ $attempt->id }};

        // Allowed face-related event types that can capture a webcam frame screenshot
        const SCREENSHOT_EVENT_TYPES = [
            'no_face_detected',
            'multiple_faces_detected',
            'abnormal_eye_movement',
            'gaze_away_left',
            'gaze_away_right',
            'gaze_away_up',
            'gaze_away_down',
            'eyes_not_detected',
            'eyes_covered_object'
        ];

        // =========================================
        // ATTEMPT-LEVEL SCREENSHOT QUOTA & INCIDENT LIMITS
        // =========================================
        let attemptScreenshotCount = 0;
        const MAX_ATTEMPT_SCREENSHOTS = 6;

        // Send Cheating Event helper with exam_attempt_id and frame screenshot
        async function reportCheatingEvent(eventType, description = '') {
            try {
                const formData = new FormData();
                formData.append('event_type', eventType);
                formData.append('exam_attempt_id', attemptId);
                if (description) {
                    formData.append('description', description);
                }

                // Strictly capture webcam frame ONLY for face-related anomalies (never tab_switch or fullscreen events)
                // and ONLY if attempt has not reached the 6-screenshot quota
                const isScreenshotEligibleEvent = SCREENSHOT_EVENT_TYPES.includes(eventType);
                const shouldCaptureScreenshot = isScreenshotEligibleEvent 
                    && attemptScreenshotCount < MAX_ATTEMPT_SCREENSHOTS 
                    && eventType !== 'face_normal';

                if (shouldCaptureScreenshot && webcam && webcam.videoWidth && webcam.videoHeight) {
                    try {
                        const canvas = document.createElement('canvas');
                        canvas.width = webcam.videoWidth;
                        canvas.height = webcam.videoHeight;
                        const ctx = canvas.getContext('2d');
                        ctx.drawImage(webcam, 0, 0, canvas.width, canvas.height);
                        const blob = await new Promise(resolve => canvas.toBlob(resolve, 'image/jpeg', 0.85));
                        if (blob) {
                            formData.append('evidence', blob, `${eventType}_${Date.now()}.jpg`);
                        }
                    } catch (snapErr) {
                        console.warn('Canvas frame capture error:', snapErr);
                    }
                }

                const response = await fetch('/cheating-event', {
                    method: 'POST',
                    headers: {
                        'X-CSRF-TOKEN': csrfToken,
                        'Accept': 'application/json'
                    },
                    body: formData
                });

                const data = await response.json();
                if (data && typeof data.screenshot_count === 'number') {
                    attemptScreenshotCount = data.screenshot_count;
                }
                if (data && data.screenshot_quota_exhausted) {
                    attemptScreenshotCount = MAX_ATTEMPT_SCREENSHOTS;
                }

                return data;
            } catch (e) {
                console.warn('Failed to log proctoring event:', e);
            }
        }

        // Initialize Shared EyeGazeTracker Instance
        const TrackerClass = window.EyeGazeTracker || EyeGazeTracker;
        const eyeGazeTracker = new TrackerClass({
            now: () => Date.now(),
            onEvent: (eventType, description) => {
                reportCheatingEvent(eventType, description);
            },
            onStatusChange: (status) => {
                const gazeStatusText = document.getElementById('gazeStatusText');
                if (gazeStatusText) {
                    gazeStatusText.textContent = status;
                    if (status === 'Centered') {
                        gazeStatusText.className = 'font-semibold text-emerald-600';
                    } else if (status === 'Blinking') {
                        gazeStatusText.className = 'font-semibold text-gray-500';
                    } else {
                        gazeStatusText.className = 'font-semibold text-amber-600';
                    }
                }
            }
        });

        // Face & Gaze Detection State
        let faceDetectionRunning = false;
        let eyeDetectionRunning = false;
        let isFaceLoopRunning = false;
        let isEyeLoopRunning = false;
        let currentFaceCount = -1;

        let noFaceStartTime = null;
        let noFaceScreenshotCount = 0;
        let multipleFaceStartTime = null;
        let multipleFaceScreenshotCount = 0;
        let faceEventActive = false;

        let lastFaceDetectorTimestamp = -1;
        let lastLandmarkerTimestamp = -1;

        const NO_FACE_CONFIRMATION_TIME = 2000;
        const NO_FACE_SAFEGUARD_TIME = 6000;
        const MULTIPLE_FACE_CONFIRMATION_TIME = 2000;
        const MULTIPLE_FACE_SAFEGUARD_TIME = 6000;

        // Start Face Detection independently as soon as window.faceDetector is ready
        async function startFaceDetection() {
            if (isFaceLoopRunning) return;

            while (!window.faceDetector) {
                await new Promise(r => setTimeout(r, 100));
            }

            const faceStatusText = document.getElementById('faceStatusText');
            if (faceStatusText) {
                faceStatusText.textContent = 'Active';
                faceStatusText.className = 'font-semibold text-emerald-600';
            }

            faceDetectionRunning = true;
            isFaceLoopRunning = true;
            detectFaces();
        }

        // Start Eye/Gaze Monitoring independently as soon as window.faceLandmarker is ready
        function startEyeMonitoring() {
            if (isEyeLoopRunning) return;

            const gazeStatusText = document.getElementById('gazeStatusText');
            if (gazeStatusText) {
                gazeStatusText.textContent = 'Active';
                gazeStatusText.className = 'font-semibold text-emerald-600';
            }

            eyeDetectionRunning = true;
            isEyeLoopRunning = true;
            detectEyeLandmarks();
        }

        function detectFaces() {
            if (!faceDetectionRunning || !isExamStarted || isSubmitting) {
                isFaceLoopRunning = false;
                return;
            }

            if (!window.faceDetector || !webcam.videoWidth || !webcam.videoHeight) {
                requestAnimationFrame(detectFaces);
                return;
            }

            try {
                let timestamp = performance.now();
                if (timestamp <= lastFaceDetectorTimestamp) {
                    timestamp = lastFaceDetectorTimestamp + 1;
                }
                lastFaceDetectorTimestamp = timestamp;

                const result = window.faceDetector.detectForVideo(webcam, timestamp);
                const detections = result.detections || [];
                const faceCount = detections.length;
                currentFaceCount = faceCount;

                const camOverlayStatus = document.getElementById('camOverlayStatus');
                const faceStatusText = document.getElementById('faceStatusText');

                if (faceCount === 0) {
                    if (camOverlayStatus) camOverlayStatus.textContent = '⚠️ No Face Detected';
                    if (faceStatusText) {
                        faceStatusText.textContent = 'No Face Detected';
                        faceStatusText.className = 'font-semibold text-amber-600';
                    }

                    if (noFaceStartTime === null) noFaceStartTime = Date.now();
                    multipleFaceStartTime = null;
                    multipleFaceScreenshotCount = 0;

                    const duration = Date.now() - noFaceStartTime;
                    if (duration >= NO_FACE_CONFIRMATION_TIME) {
                        if (noFaceScreenshotCount === 0) {
                            noFaceScreenshotCount = 1;
                            faceEventActive = true;
                            reportCheatingEvent('no_face_detected', 'No face detected in webcam stream.');
                        } else if (noFaceScreenshotCount === 1 && duration >= NO_FACE_SAFEGUARD_TIME) {
                            noFaceScreenshotCount = 2;
                            reportCheatingEvent('no_face_detected', 'No face detected in webcam stream (safeguard confirmation).');
                        }
                    }
                } else if (faceCount === 1) {
                    if (camOverlayStatus) camOverlayStatus.textContent = '✅ 1 Face Verified';
                    if (faceStatusText) {
                        faceStatusText.textContent = '1 Face Verified';
                        faceStatusText.className = 'font-semibold text-emerald-600';
                    }

                    if (faceEventActive) {
                        reportCheatingEvent('face_normal', 'Normal single face verified.');
                        faceEventActive = false;
                    }

                    noFaceStartTime = null;
                    noFaceScreenshotCount = 0;
                    multipleFaceStartTime = null;
                    multipleFaceScreenshotCount = 0;
                } else {
                    if (camOverlayStatus) camOverlayStatus.textContent = '🚨 Multiple Faces: ' + faceCount;
                    if (faceStatusText) {
                        faceStatusText.textContent = 'Multiple Faces (' + faceCount + ')';
                        faceStatusText.className = 'font-semibold text-rose-600';
                    }

                    if (multipleFaceStartTime === null) multipleFaceStartTime = Date.now();
                    noFaceStartTime = null;
                    noFaceScreenshotCount = 0;

                    const duration = Date.now() - multipleFaceStartTime;
                    if (duration >= MULTIPLE_FACE_CONFIRMATION_TIME) {
                        if (multipleFaceScreenshotCount === 0) {
                            multipleFaceScreenshotCount = 1;
                            faceEventActive = true;
                            reportCheatingEvent('multiple_faces_detected', `Multiple faces (${faceCount}) detected in webcam stream.`);
                        } else if (multipleFaceScreenshotCount === 1 && duration >= MULTIPLE_FACE_SAFEGUARD_TIME) {
                            multipleFaceScreenshotCount = 2;
                            reportCheatingEvent('multiple_faces_detected', `Multiple faces (${faceCount}) detected (safeguard confirmation).`);
                        }
                    }
                }
            } catch (err) {
                console.error('Face detection frame error:', err);
            }

            requestAnimationFrame(detectFaces);
        }

        function detectEyeLandmarks() {
            if (!eyeDetectionRunning || !isExamStarted || isSubmitting) {
                isEyeLoopRunning = false;
                return;
            }

            if (!window.faceLandmarker || !webcam.videoWidth || !webcam.videoHeight) {
                requestAnimationFrame(detectEyeLandmarks);
                return;
            }

            try {
                let timestamp = performance.now();
                if (timestamp <= lastLandmarkerTimestamp) {
                    timestamp = lastLandmarkerTimestamp + 1;
                }
                lastLandmarkerTimestamp = timestamp;

                const result = window.faceLandmarker.detectForVideo(webcam, timestamp);
                const hasMesh = result.faceLandmarks && result.faceLandmarks.length > 0;
                const isSingleFace = (currentFaceCount === 1) || (currentFaceCount === -1 && hasMesh);

                if (!isSingleFace || currentFaceCount === 0 || currentFaceCount > 1) {
                    eyeGazeTracker.processFrame({
                        faceDetected: false,
                        landmarksPresent: false,
                        isEyeClosed: false,
                        avgGazeX: null,
                        avgGazeY: null,
                        handOverEyesDetected: false
                    });
                    requestAnimationFrame(detectEyeLandmarks);
                    return;
                }

                if (!hasMesh) {
                    // Single face is detected by face detector, but eye landmarks are missing
                    eyeGazeTracker.processFrame({
                        faceDetected: true,
                        landmarksPresent: false,
                        isEyeClosed: false,
                        avgGazeX: null,
                        avgGazeY: null,
                        handOverEyesDetected: false
                    });
                    requestAnimationFrame(detectEyeLandmarks);
                    return;
                }

                const landmarks = result.faceLandmarks[0];

                // Screen left eye (subject's right): inner 133, outer 33, top 159, bottom 145
                // Screen right eye (subject's left): inner 362, outer 263, top 386, bottom 374
                const leftMinX = Math.min(landmarks[33].x, landmarks[133].x);
                const leftMaxX = Math.max(landmarks[33].x, landmarks[133].x);
                const leftWidth = leftMaxX - leftMinX;

                const rightMinX = Math.min(landmarks[362].x, landmarks[263].x);
                const rightMaxX = Math.max(landmarks[362].x, landmarks[263].x);
                const rightWidth = rightMaxX - rightMinX;

                const leftMinY = Math.min(landmarks[159].y, landmarks[145].y);
                const leftMaxY = Math.max(landmarks[159].y, landmarks[145].y);
                const leftHeight = leftMaxY - leftMinY;

                const rightMinY = Math.min(landmarks[386].y, landmarks[374].y);
                const rightMaxY = Math.max(landmarks[386].y, landmarks[374].y);
                const rightHeight = rightMaxY - rightMinY;

                const eyesValid = (leftWidth > 0.001 && rightWidth > 0.001 && leftHeight > 0.0005 && rightHeight > 0.0005);

                if (!eyesValid) {
                    eyeGazeTracker.processFrame({
                        faceDetected: true,
                        landmarksPresent: false,
                        isEyeClosed: false,
                        avgGazeX: null,
                        avgGazeY: null,
                        handOverEyesDetected: false
                    });
                    requestAnimationFrame(detectEyeLandmarks);
                    return;
                }

                const leftEAR = leftHeight / leftWidth;
                const rightEAR = rightHeight / rightWidth;
                const isEyeClosed = (leftEAR < 0.12 && rightEAR < 0.12);

                function getCenter(points) {
                    let x = 0, y = 0;
                    points.forEach(p => { x += p.x; y += p.y; });
                    return { x: x / points.length, y: y / points.length };
                }

                const leftIris = [landmarks[468], landmarks[469], landmarks[470], landmarks[471], landmarks[472]];
                const rightIris = [landmarks[473], landmarks[474], landmarks[475], landmarks[476], landmarks[477]];

                const leftIrisCenter = getCenter(leftIris);
                const rightIrisCenter = getCenter(rightIris);

                const leftGazeX = (leftIrisCenter.x - leftMinX) / leftWidth;
                const rightGazeX = (rightIrisCenter.x - rightMinX) / rightWidth;
                const avgGazeX = (leftGazeX + rightGazeX) / 2;

                const leftGazeY = (leftIrisCenter.y - leftMinY) / leftHeight;
                const rightGazeY = (rightIrisCenter.y - rightMinY) / rightHeight;
                const avgGazeY = (leftGazeY + rightGazeY) / 2;

                eyeGazeTracker.processFrame({
                    faceDetected: true,
                    landmarksPresent: true,
                    isEyeClosed: isEyeClosed,
                    avgGazeX: avgGazeX,
                    avgGazeY: avgGazeY,
                    handOverEyesDetected: false
                });

            } catch (gazeErr) {
                console.error('Gaze tracking error:', gazeErr);
            }

            requestAnimationFrame(detectEyeLandmarks);
        }

        // Start Countdown Timer

        function startTimer() {

            function updateTimerDisplay() {

                const minutes = Math.floor(remainingTimeSeconds / 60);

                const seconds = remainingTimeSeconds % 60;

                timerDisplay.textContent =

                    String(minutes).padStart(2, '0') + ':' + String(seconds).padStart(2, '0');

                if (remainingTimeSeconds <= 300) { // 5 minutes warning

                    timerDisplay.classList.add('text-rose-400');

                }

                if (remainingTimeSeconds <= 0) {

                    clearInterval(timerInterval);

                    alert('Time has expired! Submitting your examination answers now.');

                    isSubmitting = true;

                    examForm.submit();

                }

                remainingTimeSeconds--;

            }

            updateTimerDisplay();

            timerInterval = setInterval(updateTimerDisplay, 1000);

        }

        // Begin Exam Click Handler

        btnBeginExam.addEventListener('click', async function () {

            const camOk = await initCamera();

            if (!camOk) return;

            try {

                if (document.documentElement.requestFullscreen) {

                    await document.documentElement.requestFullscreen();

                }

            } catch (fsErr) {

                console.warn('Fullscreen request bypassed or failed:', fsErr);

            }

            startOverlay.style.display = 'none';

            isExamStarted = true;

            isCurrentlyFullscreen = Boolean(document.fullscreenElement);

            isCurrentlyVisible = (document.visibilityState !== 'hidden');

            startTimer();

            startFaceDetection();

            startEyeMonitoring();

        });

        // Fullscreen Change Listener (Genuine Transitions + 500ms Debounce)

        document.addEventListener('fullscreenchange', function () {

            if (!isExamStarted || isSubmitting) return;

            const isFs = Boolean(document.fullscreenElement);

            if (!isFs) {

                // User exited fullscreen - genuine transition check

                if (isCurrentlyFullscreen) {

                    isCurrentlyFullscreen = false;

                    const now = Date.now();

                    if (now - lastFullscreenExitTime >= 500) {

                        lastFullscreenExitTime = now;

                        reportCheatingEvent('fullscreen_exit', 'Student exited fullscreen during exam attempt.');

                    }

                }

                document.getElementById('fullscreenStatusText').textContent = 'Exited (Alert)';

                document.getElementById('fullscreenStatusText').className = 'font-semibold text-rose-600';

                const fullscreenWarningText = document.getElementById('fullscreenWarningText');

                if (fullscreenWarningText) {

                    fullscreenWarningText.textContent = 'You exited fullscreen mode. This suspicious event has been logged to your proctoring audit log. Please return to fullscreen immediately.';

                }

                fullscreenWarningOverlay.style.display = 'flex';

                fsWarningSeconds = 15;

                fsCountdown.textContent = 'Returning window closing in: 15s';

                clearInterval(fsWarningTimer);

                fsWarningTimer = setInterval(function () {

                    fsWarningSeconds--;

                    fsCountdown.textContent = 'Returning window closing in: ' + fsWarningSeconds + 's';

                    if (fsWarningSeconds <= 0) {

                        clearInterval(fsWarningTimer);

                        reportCheatingEvent('fullscreen_timeout', 'Student failed to return to fullscreen within 15 seconds.');

                    }

                }, 1000);

            } else {

                // Returned to fullscreen

                isCurrentlyFullscreen = true;

                fullscreenWarningOverlay.style.display = 'none';

                clearInterval(fsWarningTimer);

                document.getElementById('fullscreenStatusText').textContent = 'Enforced';

                document.getElementById('fullscreenStatusText').className = 'font-semibold text-emerald-600';

            }

        });

        btnReturnFullscreen.addEventListener('click', async function () {

            // Before allowing student to resume after fullscreen exit, verify camera stream is still live

            if (!isCameraStreamLive()) {

                const camOk = await initCamera();

                if (!camOk) {

                    alert('Camera access is required to resume the examination.');

                    return;

                }

                startFaceDetection();

                startEyeMonitoring();

            }

            try {

                if (document.documentElement.requestFullscreen) {

                    await document.documentElement.requestFullscreen();

                }

            } catch (e) {

                console.error('Failed to restore fullscreen:', e);

            }

            isCurrentlyFullscreen = true;

            fullscreenWarningOverlay.style.display = 'none';

            clearInterval(fsWarningTimer);

        });

        // Tab Switching & Blur Tracking (Genuine Transitions + 500ms Debounce)

        document.addEventListener('visibilitychange', function () {

            if (!isExamStarted || isSubmitting) return;

            const isHidden = (document.visibilityState === 'hidden' || document.hidden);

            if (isHidden) {

                if (isCurrentlyVisible) {

                    isCurrentlyVisible = false;

                    const now = Date.now();

                    if (now - lastTabSwitchTime >= 500) {

                        lastTabSwitchTime = now;

                        reportCheatingEvent('tab_switch', 'Student switched browser tab or minimized window.');

                    }

                }

                document.getElementById('focusStatusText').textContent = 'Tab Switched';

                document.getElementById('focusStatusText').className = 'font-semibold text-rose-600';

            } else {

                isCurrentlyVisible = true;

                document.getElementById('focusStatusText').textContent = 'Normal';

                document.getElementById('focusStatusText').className = 'font-semibold text-emerald-600';

            }

        });

        // Form Submit Confirmation

        examForm.addEventListener('submit', function (e) {

            if (!isSubmitting) {

                const confirmed = confirm('Are you sure you want to finish and submit your examination? Once submitted, your answers cannot be changed.');

                if (!confirmed) {

                    e.preventDefault();

                    return;

                }

            }

            isSubmitting = true;

        });

        // Progressive Answer Auto-Save

        const saveStatusText = document.getElementById('saveStatusText');

        let saveTimeout = null;

        function saveAnswerProgress(payload) {

            if (saveStatusText) saveStatusText.textContent = 'Saving...';

            fetch(saveAnswerUrl, {

                method: 'POST',

                headers: {

                    'Content-Type': 'application/json',

                    'X-CSRF-TOKEN': csrfToken,

                    'Accept': 'application/json'

                },

                body: JSON.stringify(payload)

            })

            .then(res => res.json())

            .then(data => {

                if (saveStatusText) saveStatusText.textContent = 'Answers saved';

            })

            .catch(err => {

                console.warn('Auto-save network error:', err);

                if (saveStatusText) saveStatusText.textContent = 'Retrying save...';

            });

        }

        // Auto-save on MCQ option selection

        document.querySelectorAll('input[type="radio"][name^="answers["]').forEach(radio => {

            radio.addEventListener('change', function () {

                const match = this.name.match(/answers\[(\d+)\]/);

                if (match) {

                    const questionId = parseInt(match[1]);

                    saveAnswerProgress({

                        question_id: questionId,

                        selected_option_id: parseInt(this.value)

                    });

                }

            });

        });

        // Auto-save on Written Text response (debounced 500ms)

        document.querySelectorAll('textarea[name^="answers["]').forEach(textarea => {

            textarea.addEventListener('input', function () {

                const match = this.name.match(/answers\[(\d+)\]/);

                if (match) {

                    const questionId = parseInt(match[1]);

                    const val = this.value;

                    clearTimeout(saveTimeout);

                    saveTimeout = setTimeout(() => {

                        saveAnswerProgress({

                            question_id: questionId,

                            text_answer: val

                        });

                    }, 500);

                }

            });

        });

    </script>

</body>

</html>