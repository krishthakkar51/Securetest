            'started_at' => Carbon::now()->subMinutes(30),
            'submitted_at' => Carbon::now()->subMinutes(10),
        ]);

        $this->actingAs($this->otherTeacher);

        $response = $this->get(route('teacher.classrooms.tests.attempts.grade', [
            $this->classroom,
            $this->mixedTest,
            $attempt,
        ]));

        $response->assertForbidden();
    }

