    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Suppress mouse-wheel scrolling on marks input fields to prevent accidental mark increments/decrements
            const marksInputs = document.querySelectorAll('input[name^="marks["], input[name="negative_marks"], .marks-input');
            marksInputs.forEach(function (input) {
                input.addEventListener('wheel', function (e) {
                    e.preventDefault();
                    this.blur();
                }, { passive: false });
            });
        });
    </script>
</x-app-layout>