<?php

namespace App\Models;

use Illuminate\Contracts\Auth\MustVerifyEmail;
use Database\Factories\UserFactory;
use Illuminate\Database\Eloquent\Factories\HasFactory;
use Illuminate\Foundation\Auth\User as Authenticatable;
use Illuminate\Notifications\Notifiable;
use App\Models\ActiveSession;
use App\Models\CheatingEvent;

class User extends Authenticatable implements MustVerifyEmail
{
    /** @use HasFactory<UserFactory> */
    use HasFactory, Notifiable;

    public const ROLE_TEACHER = 'teacher';
    public const ROLE_STUDENT = 'student';

    /**
     * The attributes that are mass assignable.
     *
     * @var list<string>
     */
    protected $fillable = [
        'name',
        'email',
        'password',
        'role',
        'avatar',
        'email_verified_at',
    ];

    /**
     * The attributes that should be hidden for serialization.
     *
     * @var list<string>
     */
    protected $hidden = [
        'password',
        'remember_token',
    ];

    /**
     * Get the attributes that should be cast.
     *
     * @return array<string, string>
     */
    protected function casts(): array
    {
        return [
            'email_verified_at' => 'datetime',
            'password' => 'hashed',
        ];
    }

    public function isTeacher(): bool
    {
        return $this->role === self::ROLE_TEACHER;
    }

    public function isStudent(): bool
    {
        return $this->role === self::ROLE_STUDENT;
    }

    public function initials(): string
    {
        $words = preg_split('/\s+/', trim($this->name ?: 'User'));
        if (count($words) >= 2) {
            return strtoupper(substr($words[0], 0, 1) . substr($words[1], 0, 1));
        }
        return strtoupper(substr($this->name ?: 'U', 0, 2));
    }

    public function activeSession()
    {
        return $this->hasOne(ActiveSession::class);
    }

    public function cheatingEvents()
    {
        return $this->hasMany(CheatingEvent::class);
    }

    public function createdTests()
    {
        return $this->hasMany(Test::class);
    }

    public function examAttempts()
    {
        return $this->hasMany(ExamAttempt::class);
    }

    public function ownedClassrooms()
    {
        return $this->hasMany(Classroom::class, 'user_id');
    }

    public function enrolledClassrooms()
    {
        return $this->belongsToMany(Classroom::class, 'classroom_student')
            ->select('classrooms.*')
            ->withTimestamps();
    }

    public function classroomJoinRequests()
    {
        return $this->hasMany(ClassroomJoinRequest::class);
    }

    public function materials()
    {
        return $this->hasMany(ClassroomMaterial::class);
    }
}
